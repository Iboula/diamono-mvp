@inherits LayoutComponentBase
@using Diamono.Infrastructure.Identity

<div class="shell">
    <header class="topbar">
        <a href="/" class="brand"><span class="brand-mark">D</span><span>Diamono</span></a>
        <nav>
            <a href="/">Accueil</a>
            <a href="/disponibilites">Disponibilités</a>
            <a href="/reserve">Réserver</a>
            <a href="/admin">Backoffice</a>
        </nav>
        <AuthorizeView>
            <Authorized>
                <div class="auth-badge">
                    <span class="auth-user">@DisplayName(context)</span>
                    <a class="button ghost-dark auth-logout" href="/logout">Déconnexion</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="top-cta" href="/login">Connexion</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>
    <main>@Body</main>
    <footer>
        <strong>Stade Diamono de Cambérène</strong>
        <span>Prototype MVP — règles de location provisoires à valider avec la direction.</span>
    </footer>
</div>
<RadzenComponents @rendermode="InteractiveServer" />

@code {
    private static string DisplayName(AuthenticationState state)
        => state.User.FindFirst(ApplicationUserClaimsPrincipalFactory.DisplayNameClaimType)?.Value
            ?? state.User.Identity?.Name
            ?? "Utilisateur";
}
