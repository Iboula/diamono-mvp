@inherits LayoutComponentBase
@using Diamono.Domain.Security
@using Diamono.Infrastructure.Identity

<div class="shell">
    <header class="topbar">
        <a href="/" class="brand"><span class="brand-mark">D</span><span>Diamono</span></a>
        <nav>
            <a href="/">Accueil</a>
            <a href="/disponibilites">Disponibilités</a>
            <a href="/reserve">Réserver</a>
            <a href="/admin">Dashboard</a>
            <a href="/admin/reservations">Reservations</a>
            <AuthorizeView Policy="@Permissions.PaymentsMarkPaid">
                <Authorized>
                    <a href="/admin/paiements">Paiements</a>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Permissions.AdministrationManage">
                <Authorized>
                    <a href="/admin/utilisateurs">Utilisateurs</a>
                    <a href="/admin/audit">Audit</a>
                    <a href="/admin/notifications">Notifications</a>
                </Authorized>
            </AuthorizeView>
        </nav>
        <AuthorizeView>
            <Authorized>
                <div class="auth-badge">
                    <span class="auth-user">@DisplayName(context)</span>
                    <a class="button ghost-dark auth-logout" href="/logout">Déconnexion</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="top-cta" href="/login">Connexion</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>
    <main>@Body</main>
    <footer>
        <strong class="site-credit">Conçu et développé par Social Shopping Technologies</strong>
        <span>© 2026 Social Shopping Technologies — Tous droits réservés.</span>
    </footer>
</div>
<RadzenComponents @rendermode="InteractiveServer" />

@code {
    private static string DisplayName(AuthenticationState state)
        => state.User.FindFirst(ApplicationUserClaimsPrincipalFactory.DisplayNameClaimType)?.Value
            ?? state.User.Identity?.Name
            ?? "Utilisateur";
}
