@page "/admin"
@attribute [Authorize(Policy = Permissions.BookingsView)]
@rendermode InteractiveServer
@inject ReportingApplicationService ReportingService
@inject IPermissionGuard PermissionGuard
@inject NotificationService NotificationService

<PageTitle>Dashboard - Diamono</PageTitle>

<section class="admin-head">
    <div>
        <div class="eyebrow dark">BACKOFFICE - DIRECTION</div>
        <h1>Dashboard</h1>
    </div>
    <div class="admin-head-actions">
        <RadzenButton Icon="refresh" Text="Rafraichir" ButtonStyle="ButtonStyle.Light" Click="@LoadDashboardAsync" />
    </div>
</section>

<section class="reporting-toolbar">
    <RadzenButton Text="Aujourd'hui" ButtonStyle="@PeriodButtonStyle(QuickPeriod.Today)" Click="@(() => SelectQuickPeriodAsync(QuickPeriod.Today))" />
    <RadzenButton Text="7 jours" ButtonStyle="@PeriodButtonStyle(QuickPeriod.SevenDays)" Click="@(() => SelectQuickPeriodAsync(QuickPeriod.SevenDays))" />
    <RadzenButton Text="30 jours" ButtonStyle="@PeriodButtonStyle(QuickPeriod.ThirtyDays)" Click="@(() => SelectQuickPeriodAsync(QuickPeriod.ThirtyDays))" />
    <RadzenButton Text="Ce mois" ButtonStyle="@PeriodButtonStyle(QuickPeriod.ThisMonth)" Click="@(() => SelectQuickPeriodAsync(QuickPeriod.ThisMonth))" />
    <RadzenButton Text="Mois precedent" ButtonStyle="@PeriodButtonStyle(QuickPeriod.PreviousMonth)" Click="@(() => SelectQuickPeriodAsync(QuickPeriod.PreviousMonth))" />
    <RadzenDatePicker @bind-Value="customStart" DateFormat="dd/MM/yyyy" Placeholder="Date debut" Change="@(_ => SelectCustomPeriodAsync())" Style="width:150px" />
    <RadzenDatePicker @bind-Value="customEnd" DateFormat="dd/MM/yyyy" Placeholder="Date fin" Change="@(_ => SelectCustomPeriodAsync())" Style="width:150px" />
</section>

@if (dashboard is null)
{
    <RadzenCard class="admin-card reporting-loading">Chargement du dashboard...</RadzenCard>
}
else
{
    <section class="admin-kpi-grid reporting-kpis">
        <RadzenCard class="admin-kpi-card">
            <span>Reservations du jour</span>
            <strong>@dashboard.Today.BookingsToday</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>Creneaux occupes</span>
            <strong>@dashboard.Today.OccupiedSlots</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>Creneaux disponibles</span>
            <strong>@dashboard.Today.AvailableSlots</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>Demandes en attente</span>
            <strong>@dashboard.Today.PendingApproval</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>Paiements en attente</span>
            <strong>@dashboard.Today.AwaitingPayment</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>Total periode</span>
            <strong>@dashboard.PeriodKpis.TotalBookings</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>Confirmees</span>
            <strong>@dashboard.PeriodKpis.ConfirmedBookings</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>Annulations</span>
            <strong>@dashboard.PeriodKpis.CancelledBookings</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>No-show</span>
            <strong>@dashboard.PeriodKpis.NoShowBookings</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>Recettes encaissees</span>
            <strong>@FormatMoney(dashboard.PeriodKpis.CollectedRevenue)</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>Recettes potentielles</span>
            <strong>@FormatMoney(dashboard.PeriodKpis.PotentialRevenue)</strong>
        </RadzenCard>
        <RadzenCard class="admin-kpi-card">
            <span>Taux d'occupation</span>
            <strong>@($"{dashboard.PeriodKpis.OccupationRate:N1} %")</strong>
        </RadzenCard>
    </section>

    <section class="reporting-grid">
        <RadzenCard class="admin-card reporting-chart-card">
            <div class="card-title"><h2>Reservations par jour</h2></div>
            <RadzenChart>
                <RadzenColumnSeries Data="@BookingsByDayChart" CategoryProperty="Label" ValueProperty="Value" Title="Reservations" />
                <RadzenCategoryAxis Padding="20" />
                <RadzenValueAxis />
            </RadzenChart>
        </RadzenCard>

        <RadzenCard class="admin-card reporting-chart-card">
            <div class="card-title"><h2>Recettes par jour</h2></div>
            <RadzenChart>
                <RadzenColumnSeries Data="@RevenueByDayChart" CategoryProperty="Label" ValueProperty="Value" Title="@Payment.MvpCurrency" />
                <RadzenCategoryAxis Padding="20" />
                <RadzenValueAxis />
            </RadzenChart>
        </RadzenCard>

        <RadzenCard class="admin-card reporting-chart-card">
            <div class="card-title"><h2>Categories client</h2></div>
            <RadzenChart>
                <RadzenPieSeries Data="@dashboard.CategoryBreakdown" CategoryProperty="Label" ValueProperty="Count" />
            </RadzenChart>
        </RadzenCard>

        <RadzenCard class="admin-card reporting-chart-card">
            <div class="card-title"><h2>Activites</h2></div>
            <RadzenChart>
                <RadzenPieSeries Data="@dashboard.ActivityBreakdown" CategoryProperty="Label" ValueProperty="Count" />
            </RadzenChart>
        </RadzenCard>

        <RadzenCard class="admin-card reporting-chart-card reporting-wide">
            <div class="card-title"><h2>Occupation par tranche horaire</h2></div>
            <RadzenChart>
                <RadzenColumnSeries Data="@OccupationByHourChart" CategoryProperty="Label" ValueProperty="Value" Title="Heures occupees" />
                <RadzenCategoryAxis Padding="20" />
                <RadzenValueAxis />
            </RadzenChart>
        </RadzenCard>
    </section>

    <section class="reporting-bottom">
        <RadzenCard class="admin-card reporting-insights">
            <div class="card-title"><h2>A surveiller</h2></div>
            <ul>
                @foreach (var insight in dashboard.Insights)
                {
                    <li>@insight</li>
                }
            </ul>
        </RadzenCard>

        <RadzenCard class="admin-card reporting-shortcuts">
            <div class="card-title"><h2>Raccourcis</h2></div>
            <div class="shortcut-grid">
                <a class="button primary" href="/admin/reservations">Voir reservations</a>
                @if (canMarkPaid)
                {
                    <a class="button ghost-dark" href="/admin/paiements">Paiements</a>
                }
                <a class="button ghost-dark" href="/reserve">Nouvelle reservation</a>
                <a class="button ghost-dark" href="/admin/reservations">Bloquer le terrain</a>
                @if (canViewSettings)
                {
                    <a class="button ghost-dark" href="/admin/parametres">Parametres</a>
                }
                @if (canManageAdministration)
                {
                    <a class="button ghost-dark" href="/admin/utilisateurs">Utilisateurs</a>
                    <a class="button ghost-dark" href="/admin/audit">Audit</a>
                }
            </div>
        </RadzenCard>
    </section>
}

@code {
    private ReportingDashboard? dashboard;
    private QuickPeriod selectedQuickPeriod = QuickPeriod.SevenDays;
    private DateTime? customStart;
    private DateTime? customEnd;
    private bool canViewSettings;
    private bool canManageAdministration;
    private bool canMarkPaid;

    private IReadOnlyList<ChartPoint> BookingsByDayChart =>
        dashboard?.BookingsByDay.Select(x => new ChartPoint(x.Date.ToString("dd/MM"), x.Count)).ToList() ?? [];

    private IReadOnlyList<ChartPoint> RevenueByDayChart =>
        dashboard?.RevenueByDay.Select(x => new ChartPoint(x.Date.ToString("dd/MM"), x.Amount)).ToList() ?? [];

    private IReadOnlyList<ChartPoint> OccupationByHourChart =>
        dashboard?.OccupationByHour.Select(x => new ChartPoint($"{x.Hour:00}:00", x.OccupiedHours)).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        canViewSettings = await PermissionGuard.HasPermissionAsync(Permissions.SettingsView);
        canManageAdministration = await PermissionGuard.HasPermissionAsync(Permissions.AdministrationManage);
        canMarkPaid = await PermissionGuard.HasPermissionAsync(Permissions.PaymentsMarkPaid);
        (customStart, customEnd) = PeriodDates(QuickPeriod.SevenDays);
        await LoadDashboardAsync();
    }

    private async Task SelectQuickPeriodAsync(QuickPeriod period)
    {
        selectedQuickPeriod = period;
        (customStart, customEnd) = PeriodDates(period);
        await LoadDashboardAsync();
    }

    private async Task SelectCustomPeriodAsync()
    {
        selectedQuickPeriod = QuickPeriod.Custom;
        if (customStart is not null && customEnd is not null)
            await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        if (customStart is null || customEnd is null) return;

        try
        {
            dashboard = await ReportingService.GetDashboardAsync(new ReportingPeriod(
                DateOnly.FromDateTime(customStart.Value),
                DateOnly.FromDateTime(customEnd.Value)));
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, ex.Message);
        }
    }

    private ButtonStyle PeriodButtonStyle(QuickPeriod period)
        => selectedQuickPeriod == period ? ButtonStyle.Primary : ButtonStyle.Light;

    private static (DateTime Start, DateTime End) PeriodDates(QuickPeriod period)
    {
        var today = DateTime.Today;
        return period switch
        {
            QuickPeriod.Today => (today, today),
            QuickPeriod.SevenDays => (today.AddDays(-6), today),
            QuickPeriod.ThirtyDays => (today.AddDays(-29), today),
            QuickPeriod.ThisMonth => (new DateTime(today.Year, today.Month, 1), today),
            QuickPeriod.PreviousMonth => PreviousMonth(today),
            _ => (today.AddDays(-6), today)
        };
    }

    private static (DateTime Start, DateTime End) PreviousMonth(DateTime today)
    {
        var firstThisMonth = new DateTime(today.Year, today.Month, 1);
        var firstPreviousMonth = firstThisMonth.AddMonths(-1);
        return (firstPreviousMonth, firstThisMonth.AddDays(-1));
    }

    private void Notify(NotificationSeverity severity, string message)
        => NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = severity == NotificationSeverity.Success ? "Succes" : "Erreur",
            Detail = message,
            Duration = 4500
        });

    private static string FormatMoney(decimal amount) => $"{amount:N0} {Payment.MvpCurrency}";

    private sealed record ChartPoint(string Label, decimal Value);

    private enum QuickPeriod
    {
        Today,
        SevenDays,
        ThirtyDays,
        ThisMonth,
        PreviousMonth,
        Custom
    }
}
