@page "/acces-refuse"

<PageTitle>Accès refusé — Diamono</PageTitle>

<section class="page-hero compact">
    <div class="eyebrow">BACKOFFICE</div>
    <h1>Accès refusé.</h1>
    <p>Votre compte ne dispose pas de la permission requise pour cette page.</p>
</section>

<section class="auth-wrap">
    <p class="muted">
        Si vous pensez qu'il s'agit d'une erreur, demandez à un administrateur de vérifier
        les rôles associés à votre compte.
    </p>
    <div class="auth-actions">
        <a class="button primary" href="/admin">Retour au backoffice</a>
        <a class="button ghost-dark" href="/">Aller au site public</a>
    </div>
</section>
